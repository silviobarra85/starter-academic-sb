{
  "version": "V508",
  "name": "Playwright hardening",
  "mode": "optional-browser-check",
  "script": "fanta-engine/tools/playwright-smoke-v508.mjs",
  "staticAudit": "fanta-engine/tools/audit-playwright-hardening-v508.mjs",
  "baseScriptPreserved": "fanta-engine/tools/playwright-smoke-v503.mjs",
  "defaultBaseUrl": "http://127.0.0.1:1313",
  "environment": {
    "FANTA_BASE_URL": "base URL del server locale o branch deploy",
    "FANTA_SITE_PREFIX": "prefisso opzionale, per esempio /starter-academic-sb/static quando si serve dalla cartella parent"
  },
  "cliFlags": [
    "--headed",
    "--mobile-only",
    "--desktop-only",
    "--report-dir=static/fanta-engine/reports"
  ],
  "viewports": [
    {
      "id": "mobile",
      "width": 390,
      "height": 844
    },
    {
      "id": "desktop",
      "width": 1366,
      "height": 900
    }
  ],
  "pages": [
    "/zonaorientale/",
    "/zonaorientale/competition.html",
    "/zonaorientale/player.html",
    "/fantapetillomantramanager/",
    "/fantapetillomantramanager/competition.html",
    "/fantapetillomantramanager/player.html",
    "/fantapetillomantramanager/news.html",
    "/fantapetillomantramanager/bilanci.html"
  ],
  "checks": [
    "HTTP status < 400",
    "no request failures except favicon",
    "no console error except known harmless messages",
    "no pageerror",
    "footer contains V508 where expected",
    "brand present",
    "menu/navigation present on home pages",
    "home pages mention listone/calciomercato/fantamercato",
    "JSON and Markdown report generated"
  ],
  "guardrails": [
    "no login credentials required",
    "no Firebase writes",
    "no EmailJS sends",
    "no production mutation",
    "safe for local server or Netlify branch deploy"
  ]
}
